# Create a local .env file from this template. Never commit an API key.
# Configure one provider only.
OPENAI_API_KEY=replace_me
# Optional: choose a vision-capable Responses API model available to your account.
OPENAI_MODEL=gpt-5-mini

# NVIDIA API Catalog / NIM alternative (uses its OpenAI-compatible chat endpoint).
# NVIDIA_API_KEY=replace_me
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
